# ── 複製成 .env 後填入你自己的金鑰（本機跑 npm run ingest 用）───────────────
# 在 GitHub Actions 上則設成 repository secrets（見 README）

# Finnhub — 免費註冊 https://finnhub.io  （新聞 + 美股近即時報價）
FINNHUB_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey  （免費；判多空 / 傳聞標記）
GEMINI_API_KEY=

# Telegram 推播（選用，留空則不推播）
# 1. 在 Telegram 找 @BotFather → /newbot → 拿到 token
# 2. 跟你的新 bot 講一句話，然後開 https://api.telegram.org/bot<TOKEN>/getUpdates 找 chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 前端用（Vercel 上設成 Environment Variable）──────────────────────────────
# 首次 push 後，把 snapshot.json 的 raw GitHub 網址填這裡，儀表板才會讀到即時資料
# 例：https://raw.githubusercontent.com/<你的帳號>/stock-news-radar/main/data/snapshot.json
NEXT_PUBLIC_DATA_URL=

# ── 公開 repo 專用（選用）─────────────────────────────────────────────────────
# 真實持倉不想進版控時，把整包 JSON 放這裡（或設成 GitHub Secret POSITIONS_JSON）
# 格式同 config/positions.json，例：{"account":{"size":10000,"riskPct":0.01,"currency":"USD"},"positions":[...]}
# 有設這個就會蓋過 config/positions.json
POSITIONS_JSON=
